# Place in /etc/nginx/conf.d/x2x-rate-limit.conf (http context).
# limit_req_zone cannot live inside a server { } block.
#
#   sudo cp scripts/nginx-x2x-rate-limit.conf.example /etc/nginx/conf.d/x2x-rate-limit.conf
#   sudo nginx -t && sudo systemctl reload nginx

limit_req_zone $binary_remote_addr zone=x2x_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=x2x_broadcast:10m rate=1r/s;
